# ============================================================
#  SpotOn — Environment Variable Template
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the real `.env` file to version control.
# ============================================================

# -----------------------------------------------------------------
# Database
# -----------------------------------------------------------------
# Supabase Session Pooler URI (recommended for Render / cloud hosts):
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Local PostgreSQL:
#   postgresql://USER:PASSWORD@localhost:5432/smart_parking
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# -----------------------------------------------------------------
# Individual DB vars (used as fallback if DATABASE_URL is not set)
# -----------------------------------------------------------------
DB_HOST=localhost
DB_NAME=smart_parking
DB_USER=vivek
DB_PASSWORD=

# -----------------------------------------------------------------
# Flask
# -----------------------------------------------------------------
# Generate a strong random key:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# "development" | "production" | "testing"
FLASK_ENV=development

# -----------------------------------------------------------------
# Optional — server port when running flask directly
# -----------------------------------------------------------------
PORT=5055
